<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head', { title: 'Edit Product' }) %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                        <h4 class="mb-0">
                            <i class="bi bi-pencil-square"></i>
                            Edit Product
                        </h4>

                        <a href="/products" class="btn btn-light btn-sm">
                            <i class="bi bi-arrow-left"></i>
                            Back
                        </a>

                    </div>

                    <div class="card-body">

                        <form action="/api/update/<%= product._id %>" method="POST">

                            <div class="mb-3">

                                <label class="form-label">
                                    Product Name
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    value="<%= product.name %>"
                                    required>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Category
                                </label>

                                <input
                                    type="text"
                                    name="category"
                                    class="form-control"
                                    value="<%= product.category %>"
                                    required>

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Description
                                </label>

                                <textarea
                                    name="description"
                                    rows="5"
                                    class="form-control"
                                    required><%= product.description %></textarea>

                            </div>

                            <div class="mb-4">

                                <label class="form-label">
                                    Status
                                </label>

                                <select
                                    name="status"
                                    class="form-select"
                                    required>

                                    <option value="active"
                                        <%= product.status === "active" ? "selected" : "" %>>
                                        Active
                                    </option>

                                    <option value="inactive"
                                        <%= product.status === "inactive" ? "selected" : "" %>>
                                        Inactive
                                    </option>

                                </select>

                            </div>

                            <div class="d-flex gap-2">

                                <button
                                    type="submit"
                                    class="btn btn-success">

                                    <i class="bi bi-check-circle"></i>

                                    Update Product

                                </button>

                                <a href="/products" class="btn btn-secondary">

                                    <i class="bi bi-x-circle"></i>

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <%- include('../partials/footer') %>

</body>

</html>