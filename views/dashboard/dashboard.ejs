<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head', { title: 'Dashboard' }) %>
</head>

<body class="bg-light">

    <%- include('../partials/navbar') %>

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold">
                    <i class="bi bi-speedometer2 text-primary"></i>
                    Dashboard
                </h2>

                <p class="text-muted mb-0">
                    Welcome to the RBAC Management System
                </p>

            </div>

            <% if (user && (user.role.name === "admin" || user.role.name === "manager")) { %>

                <a href="/products/create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>
                    Add Product
                </a>

            <% } else { %>

                <a href="/products" class="btn btn-success">
                    <i class="bi bi-eye"></i>
                    View Products
                </a>

            <% } %>

        </div>

        <!-- Dashboard Cards -->

        <div class="row g-4 mb-5">

            <div class="col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-box-seam display-4 text-primary"></i>

                        <h5 class="mt-3">Total Products</h5>

                        <h2 class="fw-bold">
                            <%= typeof totalProducts !== "undefined" ? totalProducts : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-check-circle-fill display-4 text-success"></i>

                        <h5 class="mt-3">Active Products</h5>

                        <h2 class="fw-bold">
                            <%= typeof activeProducts !== "undefined" ? activeProducts : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0">

                    <div class="card-body text-center">

                        <i class="bi bi-x-circle-fill display-4 text-danger"></i>

                        <h5 class="mt-3">Inactive Products</h5>

                        <h2 class="fw-bold">
                            <%= typeof inactiveProducts !== "undefined" ? inactiveProducts : 0 %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>

        <!-- User Information -->

        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">

                <h5 class="mb-0">
                    <i class="bi bi-person-circle"></i>
                    User Information
                </h5>

            </div>

            <div class="card-body">

                <table class="table table-bordered align-middle">

                    <tbody>

                        <tr>
                            <th width="30%">Name</th>
                            <td><%= user ? user.name : "Guest" %></td>
                        </tr>

                        <tr>
                            <th>Email</th>
                            <td><%= user ? user.email : "-" %></td>
                        </tr>

                        <tr>
                            <th>Role</th>
                            <td>

                                <% if (user) { %>

                                    <span class="badge bg-primary">
                                        <%= user.role.name %>
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-secondary">
                                        Guest
                                    </span>

                                <% } %>

                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <%- include('../partials/footer') %>

</body>

</html>